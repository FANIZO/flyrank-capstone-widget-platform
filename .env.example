DATABASE_URL=postgresql+psycopg://widget_user:widget_password@db:5432/widget_platform
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
ALLOWED_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=8192
GEO_PROVIDER_A_MODE=success
GEO_PROVIDER_B_MODE=success
SIDE_EFFECT_FORCE_FAILURE=false
BACKGROUND_JOB_MAX_ATTEMPTS=2
